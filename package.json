{
  "name": "dsh-restart",
  "version": "0.1.3",
  "private": true,
  "description": "DeepSeek Harness plugin: a /dsh-restart command that restarts the harness's own systemd user unit after the reply has reached the browser.",
  "type": "module",
  "license": "MIT",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "scripts": { "test": "node --experimental-test-module-mocks --test lib/*.test.js" },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./locale/*": "./locale/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "icon.svg",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": "^0.1.5-rc.2 || ^0.2.0-rc.1"
  }
}
